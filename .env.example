# Copia questo file in .env sul server: cp .env.example .env
# Con compose.yaml (Ubuntu Server, rete host) HA ascolta sempre 8123 e Node-RED 1880.

TZ=Europe/Rome
HA_CONFIG_DIR=./config
NODE_RED_DATA_DIR=./node-red

# Usate solo da compose.windows.yaml (Docker Desktop):
HA_PORT=8123
NODE_RED_PORT=1880
